# Virtual environment (your installed packages; anyone can recreate it)
.venv/

# Secrets like your Telegram bot token. Never commit this.
.env

# Python's cache files, created automatically when code runs
__pycache__/

# Log file the program writes to
uptime_log.txt

# Each user's chat ID and site list (personal data)
sites.json

# Personal notes for Claude (kept private)
CLAUDE.md

# VS Code's personal editor settings
.vscode/